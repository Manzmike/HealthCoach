#!/usr/bin/env bash
set -euo pipefail

RAG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "$RAG_DIR/.." && pwd)"
PAPERS_DIR="$PROJECT_DIR/papers"
PYTHON="$RAG_DIR/.venv/bin/python3"
export MIN_ONLY=1
export NO_AA=1

if [[ ! -x "$PYTHON" ]]; then
  printf 'HealthCoach environment not found: %s\n' "$PYTHON" >&2
  printf 'Run the first-time setup in rag/README.md, then try again.\n' >&2
  exit 1
fi

base_topics=(
  beets_dietary_nitrate
  oregano
  saffron_food
  fermented_veg_sauerkraut_kimchi
  tamarind
  blueberries
  garlic_food
  ginger_food
  honey_food
  cinnamon_food
  turmeric_food
)

printf 'Refreshing the locked foods plus the complete named whole-food library...\n'
base_jobs=${HC_BASE_FOOD_JOBS:-4}
for ((offset=0; offset<${#base_topics[@]}; offset+=base_jobs)); do
  pids=()
  for ((index=offset; index<offset+base_jobs && index<${#base_topics[@]}; index++)); do
    topic=${base_topics[$index]}
    printf '\n[%s] pulling legal open-access sources\n' "$topic"
    (cd "$PAPERS_DIR" && "$PYTHON" fetch_papers.py --topic "$topic") &
    pids+=("$!")
  done
  for pid in "${pids[@]}"; do
    wait "$pid"
  done
done

food_jobs=${HC_FOOD_JOBS:-8}
printf '\n[whole_food_library] filling per-food folders with %s resumable shards\n' "$food_jobs"
pids=()
for ((index=0; index<food_jobs; index++)); do
  (cd "$PAPERS_DIR" && "$PYTHON" fetch_papers.py --topic whole_food_library --shard "$index/$food_jobs") &
  pids+=("$!")
done
for pid in "${pids[@]}"; do
  wait "$pid"
done

printf '\nRebuilding the local search index and checking retrieval...\n'
(
  cd "$RAG_DIR"
  "$PYTHON" ingest.py --incremental
  "$PYTHON" test_retrieval.py
)

printf '\nWhole-food source refresh complete. Return to the one dashboard with:\n'
printf '  cd "%s" && ./hc\n' "$RAG_DIR"
printf 'Then choose “START / UPDATE MY PLAN” to rebuild the one report.\n'
