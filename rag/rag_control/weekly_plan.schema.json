{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthCoachWeeklyPlan",
  "type": "object",
  "required": ["week_of", "primary_focus", "actions", "not_this", "citations", "safety"],
  "properties": {
    "week_of": {"type": "string"},
    "primary_focus": {"type": "string", "maxLength": 80},
    "why": {"type": "string"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "text", "lane"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "lane": {"type": "string"},
          "done_when": {"type": "string"}
        }
      }
    },
    "not_this": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "string"}},
    "safety": {
      "type": "object",
      "required": ["drowsy_drive"],
      "properties": {
        "drowsy_drive": {"type": "string"},
        "drug": {"type": "string"}
      }
    }
  }
}
